{
  "name": "feature-consistency-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-vs-online feature consistency console with diff localization, targeted recompute, canary release and rollback",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.js'",
    "reset": "node src/reset.js"
  }
}
